/**
 * C++ facts the type system states, for the `cpp_*` tables.
 *
 * C leaves a type's lifecycle, its methods, its subtypes, the ownership of a
 * pointer and the cardinality of a buffer to convention, so wavefront takes
 * them from users (`docs/type-lifecycle.md`, `docs/pointer-properties.md`).
 * C++ declares them: a constructor, destructor, copy and move are special
 * members of their class; a method is a member; a base is written in the
 * class head; `std::unique_ptr<T>` owns one `T`, `const T &` borrows one
 * that cannot be null, `std::vector<T>` owns many and `std::string` is
 * text. Every predicate here reads declarations only: no body is followed,
 * and no value is tracked.
 *
 * Entities are named by `identity.qll`'s C++ identity, so these tables join
 * the T1 and T2 tables on name and file.
 */

import cpp
import identity

/*
 * ---------------------------------------------------------------------------
 * Classes.
 * ---------------------------------------------------------------------------
 */

/** A class the codebase defines or declares: no instantiation, no synthetic class. */
predicate isEntityClass(Class c) {
  // The codebase's own: the standard library's classes are no entity of it,
  // nor any other header outside the source root.
  exists(c.getFile().getRelativePath()) and
  isCppFile(c.getFile()) and
  not isInstantiatedType(c) and
  not isSyntheticType(c) and
  not isAnonNamed(c.getName())
}

/** The key the class-head keyword gives: `struct`, `union` or `class`. */
string keywordOf(Class c) {
  if c instanceof Union
  then result = "union"
  else
    if c instanceof Struct
    then result = "struct"
    else result = "class"
}

/** A member `m` of `c` that is special member `kind`. */
predicate specialMember(Class c, string kind, MemberFunction m) {
  m.getDeclaringType() = c and
  (
    kind = "default_ctor" and m.(Constructor).isDefault() and
    not m instanceof CopyConstructor and not m instanceof MoveConstructor
    or
    kind = "copy_ctor" and m instanceof CopyConstructor
    or
    kind = "move_ctor" and m instanceof MoveConstructor
    or
    kind = "copy_assign" and m instanceof CopyAssignmentOperator
    or
    kind = "move_assign" and m instanceof MoveAssignmentOperator
    or
    kind = "dtor" and m instanceof Destructor
  )
}

/** `m` is declared in the source: written by the user, defaulted or deleted there. */
predicate userDeclared(MemberFunction m) { not m.isCompilerGenerated() }

/**
 * How `c` has special member `kind`: `user` (a body of the user's),
 * `defaulted` or `deleted` in the source, `implicit` (generated by the
 * compiler, as the database records it), or "" when the database records
 * none. The database records an implicit member only where the compiler
 * declared it, so "" is not "absent"; `copyable` and `movable` give the
 * language's answer.
 */
string specialStatus(Class c, string kind) {
  kind = ["default_ctor", "copy_ctor", "move_ctor", "copy_assign", "move_assign", "dtor"] and
  if exists(MemberFunction m | specialMember(c, kind, m) and userDeclared(m) and not m.isDeleted() and not m.isDefaulted())
  then result = "user"
  else
    if exists(MemberFunction m | specialMember(c, kind, m) and userDeclared(m) and m.isDefaulted())
    then result = "defaulted"
    else
      if exists(MemberFunction m | specialMember(c, kind, m) and m.isDeleted())
      then result = "deleted"
      else
        if exists(MemberFunction m | specialMember(c, kind, m))
        then result = "implicit"
        else result = ""
}

/** The class whose declarations decide `c`'s: its template, for an instantiation. */
Class declaringClass(Class c) { result = canonicalUserType(c) }

/** `c`'s copy constructor is deleted, or private and the class's own (the pre-C++11 idiom). */
predicate copyDeclaredAway(Class c) {
  exists(MemberFunction m | specialMember(declaringClass(c), "copy_ctor", m) |
    m.isDeleted() or m.isPrivate()
  )
  or
  // A user-declared move suppresses the implicit copy.
  exists(MemberFunction m |
    (specialMember(declaringClass(c), "move_ctor", m) or specialMember(declaringClass(c), "move_assign", m)) and
    userDeclared(m)
  ) and
  not exists(MemberFunction m | specialMember(declaringClass(c), "copy_ctor", m) and userDeclared(m))
}

/** `c`'s move constructor is deleted. */
predicate moveDeclaredAway(Class c) {
  exists(MemberFunction m | specialMember(declaringClass(c), "move_ctor", m) | m.isDeleted())
  or
  // No move is declared and the copy that stands in for it is deleted.
  copyDeclaredAway(c) and
  not exists(MemberFunction m | specialMember(declaringClass(c), "move_ctor", m) and userDeclared(m))
}

/** The class a value of type `t` holds by value, through cv-qualifiers, typedefs and arrays. */
Class heldClass(Type t) {
  result = t.getUnspecifiedType().(Class)
  or
  result = heldClass(t.getUnspecifiedType().(ArrayType).getBaseType())
}

/** `c` is a standard container or wrapper, copyable and movable as its elements are. */
predicate isElementwiseStd(Class c) {
  isStd(c) and
  c.getSimpleName() =
    [
      "vector", "deque", "list", "forward_list", "array", "set", "multiset", "map", "multimap",
      "unordered_set", "unordered_multiset", "unordered_map", "unordered_multimap", "optional",
      "pair", "tuple", "variant"
    ]
}

/** `c` is declared in namespace `std`, or one nested in it. */
predicate isStd(Class c) { c.getNamespace().getParentNamespace*().getName() = "std" }

/** What `c` holds by value: its fields, its bases and, for a standard container, its elements. */
Class heldPart(Class c) {
  exists(Field f | f.getDeclaringType() = c and not f.isStatic() | result = heldClass(f.getType()))
  or
  result = c.getABaseClass()
  or
  isElementwiseStd(c) and result = heldClass(c.getATemplateArgument())
}

/** A copy of `c` is ill-formed: the language deletes or forbids it. */
predicate nonCopyable(Class c) {
  copyDeclaredAway(c)
  or
  nonCopyable(heldPart(c))
}

/** A move of `c` is ill-formed. */
predicate nonMovable(Class c) {
  moveDeclaredAway(c)
  or
  nonMovable(heldPart(c))
}

/**
 * `c` is trivially copyable, a Rust `Copy`: no user-provided copy, move or
 * destructor, nothing virtual, and only trivially copyable parts.
 */
predicate isTrivial(Class c) {
  not exists(MemberFunction m |
    specialMember(declaringClass(c), ["copy_ctor", "move_ctor", "copy_assign", "move_assign", "dtor"], m) and
    userDeclared(m) and
    not m.isDefaulted()
  ) and
  not exists(VirtualFunction v | v.getDeclaringType() = declaringClass(c)) and
  not exists(ClassDerivation d | d = c.getADerivation() and d.isVirtual()) and
  not exists(Class p | p = heldPart(c) and not isTrivial(p))
}

string flag(boolean b) { b = true and result = "true" or b = false and result = "false" }

/** The template parameters of a class template, `T|N`. */
string templateParamsOf(Class c) {
  if c instanceof TemplateClass
  then result = concat(int i | | c.getTemplateArgument(i).toString(), "|" order by i)
  else result = ""
}

/** The primary template an explicit or partial specialization specializes. */
TemplateClass specializedTemplate(Class c) {
  result = c.(ClassTemplateSpecialization).getPrimaryTemplate() and result != c
}

/*
 * ---------------------------------------------------------------------------
 * Members.
 * ---------------------------------------------------------------------------
 */

/** `t`, peeled of references, pointers, cv-qualifiers, typedefs and an owning standard wrapper. */
Class returnedClass(Type t) {
  exists(Type u | u = t.getUnspecifiedType() |
    result = u and not isStd(result)
    or
    result = returnedClass(u.(ReferenceType).getBaseType())
    or
    result = returnedClass(u.(PointerType).getBaseType())
    or
    isStd(u) and
    u.(Class).getSimpleName() = ["unique_ptr", "shared_ptr", "optional"] and
    result = returnedClass(u.(Class).getTemplateArgument(0))
  )
}

/**
 * What a member is to its class. The special members are its lifecycle, a
 * class-specific `operator new` or `operator delete` its allocator, and a
 * static member that returns a new object of the class, by value, pointer
 * or owning wrapper, a factory.
 */
string memberKindOf(MemberFunction m) {
  if m instanceof CopyConstructor
  then result = "copy_constructor"
  else
    if m instanceof MoveConstructor
    then result = "move_constructor"
    else
      if m instanceof Constructor
      then result = "constructor"
      else
        if m instanceof Destructor
        then result = "destructor"
        else
          if m instanceof CopyAssignmentOperator
          then result = "copy_assignment"
          else
            if m instanceof MoveAssignmentOperator
            then result = "move_assignment"
            else
              if m.getName().regexpMatch("operator (new|delete)(\\[\\])?")
              then result = "allocator"
              else
                if m instanceof ConversionOperator
                then result = "conversion"
                else
                  if m.isStatic() and
                    canonicalUserType(returnedClass(m.getType())) = canonicalUserType(m.getDeclaringType())
                  then result = "factory"
                  else
                    if m instanceof Operator
                    then result = "operator"
                    else result = "method"
}

string accessOf(MemberFunction m) {
  if m.isPublic()
  then result = "public"
  else
    if m.isProtected()
    then result = "protected"
    else result = "private"
}

/** `e` reads field `f` of `this`, or its address, or a view of it (`.get()`, `.c_str()`, `.data()`). */
predicate readsOwnField(Expr e, Field f) {
  exists(Expr u | u = e.getUnconverted() |
    u.(FieldAccess).getTarget() = f and u.(FieldAccess).getQualifier() instanceof ThisExpr
    or
    readsOwnField(u.(AddressOfExpr).getOperand(), f)
    or
    exists(FunctionCall c | c = u |
      c.getTarget().getName() = ["get", "c_str", "data"] and
      c.getNumberOfArguments() = 0 and
      readsOwnField(c.getQualifier(), f)
    )
  )
}

/** `e` writes field `f` of `this` from a parameter of `m`. */
predicate writesOwnField(Expr e, Field f, MemberFunction m) {
  exists(Expr lhs, Expr rhs |
    lhs = e.(AssignExpr).getLValue() and rhs = e.(AssignExpr).getRValue()
    or
    // A class-typed field is assigned through its `operator=`.
    e.(FunctionCall).getTarget().getName() = "operator=" and
    lhs = e.(FunctionCall).getQualifier() and
    rhs = e.(FunctionCall).getArgument(0)
  |
    lhs.(FieldAccess).getTarget() = f and
    lhs.(FieldAccess).getQualifier() instanceof ThisExpr and
    exists(VariableAccess a | a = rhs.getAChild*() | a.getTarget() = m.getAParameter())
  )
}

/**
 * A field accessor: a member whose body only returns a field of its object
 * (`getter`), or only stores a parameter into one (`setter`). Read off the
 * body's syntax: one statement, no value followed.
 */
predicate accessorOf(MemberFunction m, string kind, Field f) {
  not m.isStatic() and
  f.getDeclaringType() = m.getDeclaringType() and
  exists(BlockStmt b | b = m.getBlock() and b.getNumStmt() = 1 |
    kind = "getter" and readsOwnField(b.getStmt(0).(ReturnStmt).getExpr(), f)
    or
    kind = "setter" and writesOwnField(b.getStmt(0).(ExprStmt).getExpr(), f, m)
  )
}

/*
 * ---------------------------------------------------------------------------
 * Slots: what a parameter, return, field or global type says of the value.
 *
 * A type is read as a chain of layers, outermost first, `;`-separated, down to
 * the element it holds: `const std::vector<std::unique_ptr<Shape>> &` is
 * `cref;vector;unique_ptr;class`, its element `geo::Shape`. A layer is
 *
 *   ref, cref, rref        an lvalue reference, to const or not; an rvalue one
 *   ptr, cptr              a raw pointer, to const or not
 *   cstr, char_ptr         a pointer to characters, const or not
 *   void_ptr, cvoid_ptr    a type-erased pointer
 *   array                  a C array
 *   fnptr                  a pointer to a function
 *   <std name>             a standard wrapper or container (`unique_ptr`,
 *                          `shared_ptr`, `weak_ptr`, `optional`, `vector`,
 *                          `map`, `string`, `string_view`, `span`, ...),
 *                          followed by its element: a map's mapped type
 *
 * and the chain ends in its element's kind: `class`, `enum`, `param` (a
 * template parameter), `builtin`, or nothing when a layer is terminal
 * (`string`, `cstr`, `void_ptr`, `fnptr`, a standard type without element).
 * ---------------------------------------------------------------------------
 */

predicate isCharType(Type t) {
  t.getUnspecifiedType() instanceof CharType or
  t.getUnspecifiedType() instanceof Char8Type or
  t.getUnspecifiedType() instanceof Char16Type or
  t.getUnspecifiedType() instanceof Char32Type or
  t.getUnspecifiedType() instanceof Wchar_t
}

/** Standard wrappers and containers whose element is their first argument. */
predicate isStdElementwise(string n) {
  n =
    [
      "unique_ptr", "shared_ptr", "weak_ptr", "optional", "atomic", "vector", "deque", "list",
      "forward_list", "array", "span", "initializer_list", "valarray", "set", "multiset",
      "unordered_set", "unordered_multiset", "reference_wrapper"
    ]
}

/** Standard associative containers whose element is their mapped type. */
predicate isStdMap(string n) { n = ["map", "multimap", "unordered_map", "unordered_multimap"] }

/**
 * `t` without its top-level cv-qualifiers and typedefs. Unlike
 * `getUnspecifiedType`, which also strips them below a reference or pointer,
 * this keeps `const` on what a `const T &` refers to.
 */
Type stripTop(Type t) {
  if t instanceof SpecifiedType
  then result = stripTop(t.(SpecifiedType).getBaseType())
  else
    if t instanceof TypedefType
    then result = stripTop(t.(TypedefType).getBaseType())
    else
      if t instanceof Decltype
      then result = stripTop(t.(Decltype).getBaseType())
      else result = t
}

/** The layers of `t` (see above) and the element it ends in. */
predicate chainOf(Type t, string chain, Type elem) {
  exists(Type u | u = stripTop(t) |
    exists(Type b | b = u.(LValueReferenceType).getBaseType() |
      exists(string c | chainOf(b, c, elem) |
        if b.isConst() then chain = "cref;" + c else chain = "ref;" + c
      )
    )
    or
    exists(string c | chainOf(u.(RValueReferenceType).getBaseType(), c, elem) | chain = "rref;" + c)
    or
    exists(Type b | b = u.(PointerType).getBaseType() |
      isCharType(b) and elem = b and
      (if b.isConst() then chain = "cstr" else chain = "char_ptr")
      or
      b.getUnspecifiedType() instanceof VoidType and elem = b and
      (if b.isConst() then chain = "cvoid_ptr" else chain = "void_ptr")
      or
      b.getUnspecifiedType() instanceof RoutineType and elem = b and chain = "fnptr"
      or
      not isCharType(b) and
      not b.getUnspecifiedType() instanceof VoidType and
      not b.getUnspecifiedType() instanceof RoutineType and
      exists(string c | chainOf(b, c, elem) |
        if b.isConst() then chain = "cptr;" + c else chain = "ptr;" + c
      )
    )
    or
    exists(string c | chainOf(u.(ArrayType).getBaseType(), c, elem) | chain = "array;" + c)
    or
    u instanceof FunctionPointerIshType and not u instanceof PointerType and elem = u and chain = "fnptr"
    or
    exists(Class k, string n | k = u and isStd(k) and n = k.getSimpleName() |
      n = ["basic_string"] and chain = "string" and elem = k
      or
      n = ["basic_string_view"] and chain = "string_view" and elem = k
      or
      n = ["function", "move_only_function"] and chain = "function" and elem = k
      or
      isStdElementwise(n) and
      exists(string c | chainOf(k.getTemplateArgument(0), c, elem) | chain = n + ";" + c)
      or
      isStdMap(n) and
      exists(string c | chainOf(k.getTemplateArgument(1), c, elem) | chain = n + ";" + c)
      or
      not n = ["basic_string", "basic_string_view", "function", "move_only_function"] and
      not isStdElementwise(n) and
      not isStdMap(n) and
      chain = n and
      elem = k
    )
    or
    u instanceof Class and not isStd(u) and not u instanceof TypeTemplateParameter and
    chain = "class" and elem = u
    or
    u instanceof Enum and chain = "enum" and elem = u
    or
    u instanceof TypeTemplateParameter and chain = "param" and elem = u
    or
    u instanceof BuiltInType and not u instanceof VoidType and chain = "builtin" and elem = u
  )
}

/** The element a chain ends in, by entity name, or "" for none. */
string elemName(Type elem) {
  if elem instanceof Class and not isStd(elem) or elem instanceof Enum or elem instanceof TypeTemplateParameter
  then result = cppName(elem)
  else result = ""
}

string elemDefFile(Type elem) {
  if elem instanceof Class and not isStd(elem) or elem instanceof Enum
  then result = defFileOf(elem)
  else result = ""
}

/**
 * A slot worth a row: one whose type says something a C type does not, or
 * names a user type. A plain scalar (`int`, `double`) says nothing.
 */
bindingset[chain]
predicate informativeChain(string chain) { chain != "builtin" and chain != "enum" }
